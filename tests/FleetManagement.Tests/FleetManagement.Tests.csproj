<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1"/>
    <PackageReference Include="xunit" Version="2.9.2"/>
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all"/>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.15"/>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.15"/>
  </ItemGroup>
  <!-- Проверяем тот же исходный код без зависимости от WindowsDesktop runtime. -->
  <ItemGroup>
    <None Include="../../docs/database-install.sql" Link="database-install.sql" CopyToOutputDirectory="PreserveNewest"/>
    <None Include="../../docs/database-demo.sql" Link="database-demo.sql" CopyToOutputDirectory="PreserveNewest"/>
    <Compile Include="../../tools/PasswordMigration/MigrationPlan.cs" Link="MigrationPlan.cs"/>
    <Compile Include="../../Курсовой проект/Models/*.cs" Link="Models/%(Filename)%(Extension)"/>
    <Compile Include="../../Курсовой проект/Services/*.cs" Link="Services/%(Filename)%(Extension)"/>
    <Compile Include="../../Курсовой проект/Configuration/*.cs" Link="Configuration/%(Filename)%(Extension)"/>
    <Compile Include="../../Курсовой проект/ViewModels/*.cs" Link="ViewModels/%(Filename)%(Extension)"/>
  </ItemGroup>
</Project>
