<Window x:Class="Курсовой_проект.Views.ReportWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Обслуживание и расходы" Width="1000" Height="700" MinWidth="760" MinHeight="480" WindowStartupLocation="CenterOwner">
 <Grid Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="Обслуживание и расходы" FontSize="24" FontWeight="SemiBold"/>
   <WrapPanel x:Name="Filters" Margin="0,12">
    <StackPanel Margin="0,0,12,0"><TextBlock Text="С"/><DatePicker x:Name="From" Width="140"/></StackPanel>
    <StackPanel Margin="0,0,12,0"><TextBlock Text="По (включительно)"/><DatePicker x:Name="To" Width="140"/></StackPanel>
    <StackPanel Margin="0,0,12,0"><TextBlock Text="Автомобиль"/><ComboBox x:Name="Vehicle" Width="280" DisplayMemberPath="Name"/></StackPanel>
    <Button Content="Сформировать" Click="Generate" VerticalAlignment="Bottom"/>
   </WrapPanel>
  </StackPanel>
  <StackPanel Grid.Row="1" Margin="0,0,0,8">
   <TextBlock x:Name="Summary" FontSize="18" FontWeight="SemiBold"/>
   <TextBlock x:Name="Parameters" TextWrapping="Wrap"/>
   <TextBlock Text="Расходы — общая стоимость записанных работ. Запчасти повторно к сумме не прибавляются." Foreground="#58736D" TextWrapping="Wrap"/>
  </StackPanel>
  <ListView Grid.Row="2" x:Name="Rows" ItemContainerStyle="{StaticResource FleetCardStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
   <ListView.ItemTemplate><DataTemplate><StackPanel>
    <TextBlock Text="{Binding Vehicle}" FontWeight="SemiBold" FontSize="16"/>
    <TextBlock Text="{Binding Work}" TextWrapping="Wrap"/>
    <WrapPanel><TextBlock Text="{Binding Date, StringFormat={}{0:dd.MM.yyyy}}" Margin="0,0,16,0"/><TextBlock Text="{Binding Mileage, StringFormat=Пробег: {0} км}" Margin="0,0,16,0"/><TextBlock Text="{Binding Cost, StringFormat={}{0:N2} ₽}"/></WrapPanel>
    <TextBlock Text="{Binding Parts}" TextWrapping="Wrap" Foreground="#58736D"/>
    <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
   </StackPanel></DataTemplate></ListView.ItemTemplate>
  </ListView>
  <DockPanel Grid.Row="3" Margin="0,10,0,0">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" x:Name="Exports" IsEnabled="False">
    <Button Content="Сохранить CSV для Excel" Click="Export" Margin="8,0"/>
    <Button Content="Печать / PDF" Click="Print"/>
   </StackPanel>
   <TextBlock x:Name="Status" TextWrapping="Wrap" VerticalAlignment="Center"/>
  </DockPanel>
 </Grid>
</Window>
