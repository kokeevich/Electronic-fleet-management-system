<Window x:Class="Курсовой_проект.Views.RecordDetailsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Просмотр записи" Width="680" Height="480" MinWidth="440" MinHeight="320"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="White" CornerRadius="12" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Subtitle}" Foreground="#4D6B65" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    <Border Background="#E3F3EF" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" Margin="0,12">
                        <TextBlock Text="{Binding Badge}" TextWrapping="Wrap"/>
                    </Border>
                    <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                             Background="Transparent" TextWrapping="Wrap" Padding="0"
                             AutomationProperties.Name="Полные сведения о записи"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Button Grid.Row="1" Content="Закрыть" IsCancel="True" HorizontalAlignment="Right" Padding="16,6" Margin="0,8,0,0"/>
    </Grid>
</Window>
