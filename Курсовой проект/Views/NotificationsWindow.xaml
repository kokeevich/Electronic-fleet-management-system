<Window x:Class="Курсовой_проект.Views.NotificationsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Уведомления и сроки" Width="1000" Height="700" MinWidth="700" MinHeight="450" WindowStartupLocation="CenterOwner">
 <Grid Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel><Button x:Name="Refresh" DockPanel.Dock="Right" Content="Обновить" Click="Reload"/><TextBlock Text="Уведомления и сроки" FontSize="24" FontWeight="SemiBold"/></DockPanel>
  <WrapPanel Grid.Row="1" Margin="0,12">
   <ComboBox x:Name="Filter" Width="180" SelectionChanged="FilterChanged" SelectedIndex="0"><ComboBoxItem Content="Все предупреждения"/><ComboBoxItem Content="Только новые"/><ComboBoxItem Content="Просроченные"/><ComboBoxItem Content="Приближающиеся"/></ComboBox>
   <Button x:Name="Read" Content="Прочитано" Click="MarkRead" IsEnabled="False" Margin="8,0"/>
   <Button x:Name="Details" Content="Подробности" Click="OpenDetails" IsEnabled="False" Margin="0,0,8,0"/>
   <Button x:Name="Car" Content="История автомобиля" Click="OpenCar" IsEnabled="False"/>
  </WrapPanel>
  <ListView Grid.Row="2" x:Name="Rows" SelectionChanged="SelectionChanged" MouseDoubleClick="DoubleClick" ItemContainerStyle="{StaticResource FleetCardStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
   <ListView.ItemTemplate><DataTemplate><StackPanel>
    <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding ReadLabel}" Foreground="#58736D" Margin="10,0"/><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="17" TextWrapping="Wrap"/></DockPanel>
    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,4"/>
    <TextBlock Text="{Binding Badge}" Foreground="{Binding Color}" FontWeight="SemiBold"/>
   </StackPanel></DataTemplate></ListView.ItemTemplate>
  </ListView>
  <DockPanel Grid.Row="3" Margin="0,12,0,0">
   <StackPanel x:Name="Exports" DockPanel.Dock="Right" Orientation="Horizontal" IsEnabled="False"><Button Content="Отчёт CSV" Click="Export" Margin="8,0"/><Button Content="Печать / PDF" Click="Print"/></StackPanel>
   <TextBlock x:Name="Status" TextWrapping="Wrap"/>
  </DockPanel>
 </Grid>
</Window>
