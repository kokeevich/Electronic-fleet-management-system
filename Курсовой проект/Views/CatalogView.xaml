<UserControl x:Class="Курсовой_проект.Views.CatalogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" Content="Обновить" Command="{Binding RefreshCommand}" IsEnabled="{Binding CanRefresh}"/>
            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
        <StackPanel Grid.Row="1" Margin="0,0,0,6">
            <Label Content="_Поиск по данным карточки" Target="{Binding ElementName=SearchBox}" Padding="0,0,0,2"/>
            <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="8,4"/>
        </StackPanel>
        <!-- Действия над выбранной записью. -->
        <DockPanel Grid.Row="2" Margin="0,0,0,6">
            <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Foreground="#58736D" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <WrapPanel>
                <Button Content="Сбросить пароль" Click="ResetPassword_Click" IsEnabled="{Binding CanEditRecord}" Margin="0,0,8,0"
                        Visibility="{Binding ShowResetPassword, Converter={StaticResource BoolVisibility}}"/>
                <Button Content="Добавить" Click="AddRecord_Click" IsEnabled="{Binding CanCreateRecord}" Margin="0,0,8,0"
                        Visibility="{Binding CanCreateDelete, Converter={StaticResource BoolVisibility}}"/>
                <Button Content="Удалить" Click="DeleteRecord_Click" IsEnabled="{Binding CanDeleteRecord}" Margin="0,0,8,0"
                        Background="#FCEBE9" Foreground="#B42318"
                        Visibility="{Binding CanCreateDelete, Converter={StaticResource BoolVisibility}}"/>
                <Button Content="Изменить" IsEnabled="{Binding CanEditRecord}" Click="EditRecord_Click"
                        Visibility="{Binding CanManageSection, Converter={StaticResource BoolVisibility}}"/>
            </WrapPanel>
        </DockPanel>
        <ListView MouseDoubleClick="Audit_DoubleClick" Grid.Row="3" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                  ItemContainerStyle="{StaticResource FleetCardStyle}"
                  Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  AutomationProperties.Name="{Binding Title}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="155"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                            <TextBlock Text="{Binding Subtitle}" Foreground="#4D6B65" Margin="0,2,0,0"
                                       FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Subtitle}"/>
                            <TextBlock Text="{Binding DetailsPreview}" ToolTip="{Binding Details}" Foreground="#58736D" Margin="0,2,0,0"
                                       FontSize="12" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#E3F3EF" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Badge}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <StackPanel Grid.Row="4" Margin="0,6,0,0">
            <ProgressBar Height="2" Margin="0,0,0,4" IsIndeterminate="{Binding IsBusy}"/>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
    </Grid>
</UserControl>
