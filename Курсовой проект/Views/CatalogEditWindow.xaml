<Window x:Class="Курсовой_проект.Views.CatalogEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="640" Height="700" MinWidth="480" MinHeight="430"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12" TextWrapping="Wrap"/>
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Fields}" IsEnabled="{Binding CanSave}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="{Binding Label}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" MaxLength="{Binding MaxLength}"
                                         Padding="8,5" TextWrapping="Wrap" AcceptsReturn="{Binding IsMultiline}"
                                         AutomationProperties.Name="{Binding Label}">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPassword}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                <DataTrigger Binding="{Binding IsChoice}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsMultiline}" Value="True">
                                                    <Setter Property="Height" Value="90"/>
                                                    <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                <PasswordBox PasswordChanged="Password_Changed" MaxLength="128" Padding="8,5"
                                             Visibility="{Binding IsPassword, Converter={StaticResource BoolVisibility}}"
                                             AutomationProperties.Name="{Binding Label}"/>
                                <ComboBox ItemsSource="{Binding Options}" SelectedValue="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="Value" DisplayMemberPath="Label" Padding="8,5"
                                          Visibility="{Binding IsChoice, Converter={StaticResource BoolVisibility}}"
                                          AutomationProperties.Name="{Binding Label}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#49665F" AutomationProperties.LiveSetting="Assertive"/>
            <ProgressBar Height="2" Margin="0,8" IsIndeterminate="{Binding IsBusy}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Сохранить" Click="Save_Click" IsDefault="True" IsEnabled="{Binding CanSave}" Padding="16,6" Margin="0,0,8,0"/>
                <Button Content="Отмена" IsCancel="True" IsEnabled="{Binding CanClose}" Padding="16,6" Background="#E3F3EF" Foreground="#0F766E"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
