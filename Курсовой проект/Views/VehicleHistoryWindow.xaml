<Window x:Class="Курсовой_проект.Views.VehicleHistoryWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="История автомобиля" Width="950" Height="700" MinWidth="650" MinHeight="450" WindowStartupLocation="CenterOwner">
 <Window.Resources>
  <DataTemplate x:Key="HistoryCard"><StackPanel>
   <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Badge}" Foreground="#0F766E" Margin="12,0,0,0"/><TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/></DockPanel>
   <TextBlock Text="{Binding Subtitle}" Margin="0,4" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding Details}" Foreground="#58736D" TextWrapping="Wrap"/>
  </StackPanel></DataTemplate>
 </Window.Resources>
 <Grid Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel>
   <Button x:Name="Refresh" DockPanel.Dock="Right" Content="Обновить" Click="Reload"/>
   <TextBlock x:Name="Heading" Text="История автомобиля" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
  </DockPanel>
  <StackPanel Grid.Row="1" Margin="0,10">
   <TextBlock x:Name="Summary" TextWrapping="Wrap"/>
   <TextBlock Text="Затраты включают стоимость работ. Запчасти повторно к сумме не прибавляются." Foreground="#58736D" TextWrapping="Wrap"/>
  </StackPanel>
  <TabControl Grid.Row="2">
   <TabItem x:Name="AssignmentsTab" Header="Закрепления"><ListView x:Name="Assignments" ItemTemplate="{StaticResource HistoryCard}" ItemContainerStyle="{StaticResource FleetCardStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/></TabItem>
   <TabItem x:Name="DocumentsTab" Header="Документы"><ListView x:Name="Documents" ItemTemplate="{StaticResource HistoryCard}" ItemContainerStyle="{StaticResource FleetCardStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/></TabItem>
   <TabItem x:Name="MaintenanceTab" Header="ТО и ремонты"><ListView x:Name="Maintenance" ItemTemplate="{StaticResource HistoryCard}" ItemContainerStyle="{StaticResource FleetCardStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/></TabItem>
  </TabControl>
  <DockPanel Grid.Row="3" Margin="0,10,0,0">
   <Button DockPanel.Dock="Right" Content="Закрыть" IsCancel="True"/>
   <TextBlock x:Name="Status" TextWrapping="Wrap" VerticalAlignment="Center"/>
  </DockPanel>
 </Grid>
</Window>
