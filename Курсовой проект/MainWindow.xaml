<Window x:Class="Курсовой_проект.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Автопарк — управление транспортом" Width="1120" Height="720"
        MinWidth="850" MinHeight="560" WindowStartupLocation="CenterScreen">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,24">
            <TextBlock Text="АВТОПАРК" Foreground="#235CE6" FontWeight="Bold"/>
            <TextBlock Text="Управление транспортом" FontSize="30" FontWeight="SemiBold" Margin="0,6,0,4"/>
            <TextBlock Text="Транспорт организации и состояние подключения" Foreground="#64748B"/>
        </StackPanel>
        <TabControl Grid.Row="1" Background="White" BorderBrush="#DFE6F0" Padding="20">
            <TabItem Header="Транспорт">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,16">
                        <Button DockPanel.Dock="Right" Content="Обновить" Command="{Binding RefreshCommand}"/>
                        <TextBlock Text="Транспортные средства" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Vehicles}" AutomationProperties.Name="Транспортные средства">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Госномер" Binding="{Binding LicensePlate}" Width="120"/>
                            <DataGridTextColumn Header="Марка" Binding="{Binding Brand}" Width="*"/>
                            <DataGridTextColumn Header="Модель" Binding="{Binding Model}" Width="*"/>
                            <DataGridTextColumn Header="Год" Binding="{Binding YearOfManufacture}" Width="70"/>
                            <DataGridTextColumn Header="Пробег, км" Binding="{Binding Mileage, StringFormat=N0}" Width="110"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="170"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Подключение">
                <StackPanel Margin="20" MaxWidth="650" HorizontalAlignment="Left">
                    <TextBlock Text="Подключение к базе данных" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,16" TextWrapping="Wrap" Text="Укажите строку подключения в переменной FLEET_CONNECTION_STRING или в файле %LOCALAPPDATA%\FleetManagement\connection.txt и нажмите «Обновить». Подробная инструкция находится в README проекта."/>
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
                    <Button Content="Обновить" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" Margin="0,20,0,0"/>
                </StackPanel>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="2" Margin="0,18,0,0">
            <ProgressBar Height="3" IsIndeterminate="{Binding IsBusy}" Margin="0,0,0,10"/>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#475569"
                       AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
    </Grid>
</Window>
