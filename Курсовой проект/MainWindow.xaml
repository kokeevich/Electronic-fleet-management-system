<Window x:Class="Курсовой_проект.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Курсовой_проект.Views"
        Title="Автопарк" Width="1120" Height="720" MinWidth="850" MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="NotificationButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E3F3EF"/>
            <Setter Property="Foreground" Value="#0F766E"/>
            <Setter Property="BorderBrush" Value="#C7E5DD"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#CDEBE3"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#70B7A6"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#0F766E"/>
                                <Setter TargetName="Surface" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#B4DFD3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="16,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,8">
            <Button x:Name="NotificationsButton" DockPanel.Dock="Right" Click="Notifications_Click"
                    Style="{StaticResource NotificationButtonStyle}" Width="52" Height="46"
                    ToolTip="Уведомления" AutomationProperties.Name="Уведомления" Margin="8,0" VerticalAlignment="Center">
                <Grid Width="50" Height="44">
                    <Viewbox Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Data="M 18 8 C 18 4.7 15.3 2 12 2 C 8.7 2 6 4.7 6 8 C 6 15 3 15 3 17 L 21 17 C 21 15 18 15 18 8 M 10 21 C 10.6 22.3 13.4 22.3 14 21"
                                  Stroke="#0F766E" StrokeThickness="1.8" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                    <Border x:Name="NotificationBadge" Background="#D64545" BorderBrush="#F5FAF8" BorderThickness="2"
                            CornerRadius="11" MinWidth="22" Height="22" Margin="0,-3,-3,0"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed">
                        <TextBlock x:Name="NotificationCount" Foreground="White" FontSize="10" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0"/>
                    </Border>
                </Grid>
            </Button>
            <Button x:Name="ReportsButton" DockPanel.Dock="Right" Content="Отчёты" Click="Reports_Click" Margin="8,0" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Content="Выйти" Click="Logout_Click"
                    IsEnabled="{Binding Fleet.IsIdle}" Margin="12,0,0,0" VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" MaxWidth="300" VerticalAlignment="Center" Margin="16,0,0,0">
                <TextBlock Text="{Binding Fleet.UserName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Fleet.RoleName}" Foreground="#58736D" FontSize="12"/>
            </StackPanel>
            <TextBlock Text="АВТОПАРК" Foreground="#0F766E" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <Label Content="_Раздел" Target="{Binding ElementName=SectionNavigation}" VerticalAlignment="Center" Padding="0,0,10,0"/>
            <ComboBox x:Name="SectionNavigation" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}"
                      DisplayMemberPath="Title" Padding="8,4" MinWidth="260" MaxWidth="420"
                      HorizontalAlignment="Left" IsEnabled="{Binding Fleet.IsIdle}"/>
        </DockPanel>
        <Border Grid.Row="2" Background="White" BorderBrush="#D8E6E0" BorderThickness="1" CornerRadius="10" Padding="12,8">
            <Grid>
                <Grid Visibility="{Binding IsVehicles, Converter={StaticResource BoolVisibility}}">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid DataContext="{Binding Fleet}">
                        <Grid Margin="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Content="Обновить" Command="{Binding RefreshCommand}" IsEnabled="{Binding IsIdle}"/>
                                <TextBlock Text="Транспортные средства" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Grid Grid.Row="1" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <Label Content="_Поиск по госномеру, марке или модели" Target="{Binding ElementName=SearchBox}" Padding="0,0,0,2"/>
                                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="8,4"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <Label Content="_Статус" Target="{Binding ElementName=StatusFilter}" Padding="0,0,0,2"/>
                                    <ComboBox x:Name="StatusFilter" ItemsSource="{Binding Statuses}" SelectedItem="{Binding SelectedStatus}" Padding="8,4"/>
                                </StackPanel>
                            </Grid>
                            <DockPanel Grid.Row="2" Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding ResultSummary}" Foreground="#58736D" VerticalAlignment="Center"/>
                                <WrapPanel>
                                    <Button Content="История автомобиля" Click="VehicleHistory_Click" IsEnabled="{Binding CanOpenCard}" Margin="0,0,8,0"/>
                                    <Button Content="Добавить" Click="AddVehicle_Click" IsEnabled="{Binding CanAdd}"
                                            Visibility="{Binding CanManageVehicles, Converter={StaticResource BoolVisibility}}" Margin="0,0,8,0"/>
                                    <Button Content="Изменить" Click="OpenVehicle_Click" IsEnabled="{Binding CanEditSelection}" Margin="0,0,8,0"
                                            Visibility="{Binding CanManageVehicles, Converter={StaticResource BoolVisibility}}"/>
                                    <Button Content="Удалить" Click="DeleteVehicle_Click" IsEnabled="{Binding CanEditSelection}"
                                            Visibility="{Binding CanManageVehicles, Converter={StaticResource BoolVisibility}}"
                                            Background="#FCEBE9" Foreground="#B42318" Margin="0"/>
                                </WrapPanel>
                            </DockPanel>
                            <ListView Grid.Row="3" ItemsSource="{Binding Vehicles}" SelectedItem="{Binding SelectedVehicle}" BorderThickness="0"
                                      ItemContainerStyle="{StaticResource FleetCardStyle}"
                                      Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                      AutomationProperties.Name="Транспортные средства">

                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="170"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Brand}"/><Run Text=" "/><Run Text="{Binding Model}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding LicensePlate}" Foreground="#4D6B65" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Mileage, StringFormat={}{0:N0} км}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding YearOfManufacture, StringFormat={}Год выпуска: {0}}"
                                                           Foreground="#58736D" FontSize="12" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Border Grid.Column="2" CornerRadius="8" Padding="8,4" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#EBF0ED"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="В эксплуатации">
                                                                <Setter Property="Background" Value="#DCF4E7"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="В ремонте">
                                                                <Setter Property="Background" Value="#FFF0CB"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Grid>
                    <StackPanel Grid.Row="1" Margin="0,6,0,0">
                        <ProgressBar Height="2" IsIndeterminate="{Binding Fleet.IsBusy}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding Fleet.Status}" TextWrapping="Wrap" Foreground="#49665F" FontSize="12"
                                   AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                </Grid>
                <views:CatalogView x:Name="CatalogPanel" DataContext="{Binding Catalog}"
                    Visibility="{Binding DataContext.IsCatalog, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVisibility}}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
