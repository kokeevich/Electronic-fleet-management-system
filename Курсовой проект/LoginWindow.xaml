<Window x:Class="Курсовой_проект.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Курсовой_проект"
        mc:Ignorable="d"
        Title="Авторизация" Height="420" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F5F5F5">
    <Border Margin="20" Background="White" CornerRadius="8"
            BorderBrush="#DDDDDD" BorderThickness="1">
        <StackPanel Margin="25">
            <TextBlock Text="Учёт транспортных средств"
                       FontSize="16" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,5"/>
            <TextBlock Text="Вход в систему"
                       FontSize="13" Foreground="#666666"
                       HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Логин" Margin="0,0,0,3"/>
            <TextBox x:Name="LoginTextBox" Height="30" Padding="5,3"
                     BorderBrush="#CCCCCC"/>

            <TextBlock Text="Пароль" Margin="0,10,0,3"/>
            <PasswordBox x:Name="PasswordBox" Height="30" Padding="5,3"
                         BorderBrush="#CCCCCC" KeyDown="PasswordBox_KeyDown"/>

            <TextBlock x:Name="ErrorTextBlock" Foreground="Red"
                       TextWrapping="Wrap" Margin="0,8,0,0"/>

            <Button Content="Войти" Height="35" Margin="0,15,0,0"
                    Background="#2E7D32" Foreground="White"
                    FontWeight="SemiBold" Click="LoginButton_Click"/>
        </StackPanel>
    </Border>
</Window>
