<Window x:Class="Курсовой_проект.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Автопарк — вход" Width="860" Height="600"
        MinWidth="740" MinHeight="560" WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.9*"/>
            <ColumnDefinition Width="1.1*"/>
        </Grid.ColumnDefinitions>
        <Border Background="#172B4D" CornerRadius="20,0,0,20" Padding="30">
            <Grid>
                <StackPanel>
                    <TextBlock Text="АВТОПАРК" Foreground="#9BBEFF" FontWeight="Bold" FontSize="15"/>
                    <TextBlock Text="Всё важное —&#10;в одном месте." Foreground="White"
                               FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,55,0,20"/>
                    <TextBlock Text="Транспорт, водители&#10;и обслуживание вашего автопарка."
                               Foreground="#C5D3E9" FontSize="16" TextWrapping="Wrap"/>
                </StackPanel>
                <TextBlock VerticalAlignment="Bottom" Text="Электронная система&#10;управления автопарком"
                           Foreground="#9BB0CF" TextWrapping="Wrap"/>
            </Grid>
        </Border>
        <Border Grid.Column="1" Background="White" CornerRadius="0,20,20,0" Padding="32">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Добро пожаловать" FontSize="27" FontWeight="SemiBold"/>
                <TextBlock Text="Войдите в свою учётную запись" Foreground="#64748B" Margin="0,8,0,28"/>
                <Label Content="_Логин" Target="{Binding ElementName=LoginTextBox}" Padding="0,0,0,6"/>
                <TextBox x:Name="LoginTextBox" Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="100" Padding="10" FontSize="15" IsEnabled="{Binding CanSubmit}"/>
                <Label Content="_Пароль" Target="{Binding ElementName=PasswordBox}" Padding="0" Margin="0,18,0,6"/>
                <PasswordBox x:Name="PasswordBox" MaxLength="1024" Padding="10" FontSize="15"
                             IsEnabled="{Binding CanSubmit}"/>
                <TextBlock Text="{Binding Error}" Foreground="#B42318" TextWrapping="Wrap" Margin="0,14,0,4"
                           AutomationProperties.LiveSetting="Assertive"/>
                <Button Content="Войти" IsDefault="True" Click="LoginButton_Click"
                        IsEnabled="{Binding CanSubmit}" Margin="0,12,0,0"/>
                <ProgressBar Height="3" Margin="0,10,0,0" IsIndeterminate="{Binding IsBusy}"/>
                <TextBlock Text="Не получается войти? Обратитесь к администратору."
                           TextWrapping="Wrap" Foreground="#64748B" FontSize="12" Margin="0,22,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
