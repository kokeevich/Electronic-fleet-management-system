<Window x:Class="Курсовой_проект.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Автопарк — регистрация" Width="560" Height="760"
        MinWidth="480" MinHeight="600" WindowStartupLocation="CenterOwner">
    <Border Margin="24" Background="White" CornerRadius="16" Padding="28">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="Создать учётную запись" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="Новая учётная запись получает роль «Наблюдатель» с доступом к просмотру."
                           Foreground="#58736D" TextWrapping="Wrap" Margin="0,8,0,20"/>
                <StackPanel IsEnabled="{Binding CanSubmit}">
                    <Label Content="_Фамилия" Target="{Binding ElementName=LastNameTextBox}" Padding="0,0,0,5"/>
                    <TextBox x:Name="LastNameTextBox" Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="100" Padding="10"/>
                    <Label Content="_Имя" Target="{Binding ElementName=FirstNameTextBox}" Padding="0" Margin="0,12,0,5"/>
                    <TextBox x:Name="FirstNameTextBox" Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="100" Padding="10"/>
                    <Label Content="_Отчество (необязательно)" Target="{Binding ElementName=MiddleNameTextBox}"
                           Padding="0" Margin="0,12,0,5"/>
                    <TextBox x:Name="MiddleNameTextBox" Text="{Binding MiddleName, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="100" Padding="10"/>
                    <Label Content="_Логин" Target="{Binding ElementName=LoginTextBox}" Padding="0" Margin="0,12,0,5"/>
                    <TextBox x:Name="LoginTextBox" Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="100" Padding="10"/>
                    <Label Content="_Пароль" Target="{Binding ElementName=PasswordBox}" Padding="0" Margin="0,12,0,5"/>
                    <PasswordBox x:Name="PasswordBox" MaxLength="128" Padding="10"/>
                    <TextBlock Text="От 8 до 128 символов" Foreground="#58736D" FontSize="12" Margin="0,4,0,0"/>
                    <Label Content="По_вторите пароль" Target="{Binding ElementName=ConfirmationBox}" Padding="0" Margin="0,12,0,5"/>
                    <PasswordBox x:Name="ConfirmationBox" MaxLength="128" Padding="10"/>
                </StackPanel>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#B42318"
                           Margin="0,14,0,4" AutomationProperties.LiveSetting="Assertive"/>
                <Button Content="Зарегистрироваться" Click="RegisterButton_Click" IsDefault="True"
                        IsEnabled="{Binding CanSubmit}" Margin="0,10,0,0"/>
                <Button Content="Назад ко входу" IsCancel="True" IsEnabled="{Binding CanSubmit}"
                        Background="#E3F3EF" Foreground="#0F766E" Margin="0,8,0,0"/>
                <ProgressBar Height="3" Margin="0,8,0,0" IsIndeterminate="{Binding IsBusy}"/>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
